{
  "name": "cairn",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "cairn",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "apps/cli",
        "apps/desktop",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/cli": {
      "name": "@cairn/cli",
      "version": "0.0.0"
    },
    "apps/desktop": {
      "name": "@cairn/desktop",
      "version": "0.0.0"
    },
    "node_modules/@cairn/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@cairn/content": {
      "resolved": "packages/content",
      "link": true
    },
    "node_modules/@cairn/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@cairn/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@cairn/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "node_modules/@cairn/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/content": {
      "name": "@cairn/content",
      "version": "0.0.0"
    },
    "packages/engine": {
      "name": "@cairn/engine",
      "version": "0.0.0"
    },
    "packages/storage": {
      "name": "@cairn/storage",
      "version": "0.0.0"
    },
    "packages/ui": {
      "name": "@cairn/ui",
      "version": "0.0.0"
    }
  }
}
